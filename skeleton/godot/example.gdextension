[configuration]

entry_symbol = "example_library_init"
compatibility_minimum = "4.4"
reloadable = false

[libraries]

macos.debug = "res://libexample.dylib"
macos.release = "res://libexample.dylib"
windows.debug = "res://libexample.dll"
windows.release = "res://libexample.dll"
linux.debug = "res://libexample.so"
linux.release = "res://libexample.so"
